+    void shouldNotFailWhenReferenceQtyIsZeroAndFlagMissingReference() {
+        // Chưa có GRN (3-way) -> referenceQty = 0: không ném lỗi, để engine sinh MISSING_GRN cho dòng này
+        VarianceResult result = calculator.calculate(
+                new BigDecimal("10"), BigDecimal.ZERO,
+                new BigDecimal("1000"), new BigDecimal("1000"),
+                CurrencyCode.VND, CurrencyCode.VND
+        );
+
+        assertThat(result.missingReferenceQty()).isTrue();
+        assertThat(result.qtyVariance()).isEqualByComparingTo("10.0000");
+        assertThat(result.qtyVariancePct()).isNull();
+        assertThat(result.amountVariance()).isEqualByComparingTo("10000.0000");
+
+        ToleranceThreshold generous = new ToleranceThreshold(
+                new BigDecimal("100"), new BigDecimal("100"), null, true);
+        assertThat(calculator.isWithinTolerance(result, generous)).isFalse();
+    }
+
+    @Test
+    void shouldNotFlagMissingReferenceForNormalLines() {
+        VarianceResult result = calculator.calculate(
+                new BigDecimal("10"), new BigDecimal("10"),
+                new BigDecimal("1000"), new BigDecimal("1000"),
+                CurrencyCode.VND, CurrencyCode.VND
+        );
+        assertThat(result.missingReferenceQty()).isFalse();
+    }
+}
